datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  sources         Source[]
  userArticles    UserArticleState[]
  // This new line creates the necessary connection to the user's trend data.
  trendDataPoints TrendDataPoint[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  countryCode            String?          // ISO 3166-1 alpha-2 (auto-detected via geolocation)
  countryName            String?          // "India", "Nigeria", etc. (from reverse geocoding)
  preferredCategories    String[]         @default([])
  hasCompletedOnboarding Boolean          @default(false)
  projects      Project[]
  rankedTrends  RankedTrend[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]
  subscription  Subscription?
  creditBalance Int              @default(0) // kept in sync with CreditLedger via transactions
  ledger        CreditLedger[]
  geoWatches    UserGeoWatch[]
}

// Append-only journal of every credit movement. User.creditBalance is the
// cached sum — both are always written in the same transaction (src/lib/credits.ts).
model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int      // +grant / -spend
  reason    String   // "signup_grant", "ingest_scan", "narrative_discovery", "api_usage", "monthly_grant", "redeem_grant", "refund"
  refType   String?  // "IngestRun" | "Project" | "ApiKey" | "RedeemCode" | "Plan"
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

enum SourceType {
  RSS
}

model Source {
  id          String   @id @default(cuid())
  name        String
  url         String   @unique
  category    String?  @default("General") // ✅ Made optional with default
  type        String   @default("RSS")     // ✅ Added type field to match your API
  isActive    Boolean  @default(true)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  articles    Article[]
  
  createdAt   DateTime @default(now())     // ✅ Added missing field
}


model Article {
  id             String            @id @default(cuid())
  sourceId       String
  source         Source            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title          String
  link           String            @unique
  content        String?           @db.Text
  cleanedContent String?           @db.Text
  publishedDate  DateTime
  guid           String            @unique
  analysis       ArticleAnalysis?
  userStates     UserArticleState[]
  createdAt      DateTime          @default(now())
}

model ArticleAnalysis {
  id        String   @id @default(cuid())
  articleId String   @unique
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  summary   String?  @db.Text
  keywords  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserArticleState {
  userId    String
  articleId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  isRead    Boolean @default(false)
  isSaved   Boolean @default(false)
  isLiked   Boolean @default(false)
  readAt    DateTime?
  @@id([userId, articleId])
}

model TrendDataPoint {
  id        String   @id @default(cuid())
  keyword   String
  timestamp DateTime
  count     Int
  createdAt DateTime @default(now())

  // These new lines add the connection to the User model.
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // This updates the unique constraint to be per-user, which is more robust.
  @@unique([keyword, timestamp, userId], name: "keyword_timestamp_userId")
}

model Signal {
  id             String           @id @default(cuid())
  title          String
  url            String           @unique
  source         String
  category       String?
  publishedAt    DateTime
  createdAt      DateTime         @default(now())

  // --- Enrichment fields ---
  isEnriched     Boolean          @default(false)
  enrichedAt     DateTime?
  sentiment      String?          // POSITIVE | NEGATIVE | NEUTRAL | MIXED
  sentimentScore Float?           // -1.0 to 1.0

  // --- Relations ---
  entities       SignalEntity[]
  keywords       SignalKeyword[]
  locations      SignalLocation[]

  @@index([isEnriched, createdAt])
}

model SignalEntity {
  id        String @id @default(cuid())
  signalId  String
  signal    Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  name      String
  type      String // PERSON | ORG | COMPANY | COUNTRY | LOCATION
  salience  Float  // 0.0 to 1.0

  @@index([signalId])
  @@index([name, type])
}

model SignalKeyword {
  id       String @id @default(cuid())
  signalId String
  signal   Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  keyword  String // lowercased, trimmed
  weight   Float  // 0.0 to 1.0

  @@index([signalId])
  @@index([keyword])
}

model SignalLocation {
  id           String    @id @default(cuid())
  signalId     String
  signal       Signal    @relation(fields: [signalId], references: [id], onDelete: Cascade)
  name         String
  locationType String    // CITY | STATE | COUNTRY | REGION
  countryCode  String?   // ISO 3166-1 alpha-2
  lat          Float?
  lng          Float?
  h3Cell       String?   // H3 res-5 cell of (lat,lng) — heatmap + radius bucketing

  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id])

  @@index([signalId])
  @@index([countryCode])
  @@index([locationId])
  @@index([h3Cell])
}

// ==============================================================================
// LOCATION HIERARCHY (Phase 3)
// ==============================================================================

model Location {
  id          String     @id @default(cuid())
  name        String
  type        String     // REGION | COUNTRY | STATE | DISTRICT | CITY
  countryCode String?    // ISO 3166-1 alpha-2 (null for REGIONs)
  parentId    String?
  parent      Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children    Location[] @relation("LocationTree")
  aliases     String[]
  lat         Float?
  lng         Float?
  createdAt   DateTime   @default(now())

  // GeoNames gazetteer fields (null for hand-seeded legacy rows)
  geonameId   Int?       @unique
  asciiName   String?
  admin1Code  String?    // state/province code within country
  admin2Code  String?    // district/county code within admin1
  population  Int        @default(0) // disambiguation weight: bigger wins

  signalLocations SignalLocation[]

  @@unique([name, type, parentId])
  @@index([parentId])
  @@index([type])
  @@index([countryCode])
  @@index([countryCode, admin1Code])
  @@index([name])
}

// ==============================================================================
// GEO WATCHES & CACHES (v08.2026 globe)
// ==============================================================================

model UserGeoWatch {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   // "Home", "Delhi NCR", ...
  centerLat  Float
  centerLng  Float
  radiusKm   Int
  h3Cells    String[] // res-5 cells covering the radius, precomputed on save
  categories String[] @default([]) // niche filter; empty = all
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// Radius trend ranking is a Gemini call — cache by the covering cell set so
// overlapping watches (two users on the same city) share one computation.
model GeoTrendCache {
  id          String   @id @default(cuid())
  cellSetHash String   // sha1 of sorted covering cells + category filter
  window      String   // "6h" | "24h"
  trends      Json
  computedAt  DateTime @default(now())

  @@unique([cellSetHash, window])
  @@index([computedAt])
}

// On-demand ingestion spawned by user radii: generated Google News RSS queries
// for places inside a watch. Ref-counted so abandoned areas stop being fetched.
model GeoFeedWatch {
  id          String    @id @default(cuid())
  queryUrl    String    @unique
  placeName   String
  countryCode String?
  h3Cell      String?
  refCount    Int       @default(1)
  isActive    Boolean   @default(true)
  lastFetched DateTime?
  createdAt   DateTime  @default(now())

  @@index([isActive, lastFetched])
}

// Regional trend rankings are a Gemini call — cache per (region, window) so
// every viewer of "Goa / 7d" shares one computation.
model RegionTrendCache {
  id           String   @id @default(cuid())
  regionKey    String   // e.g. "IN" | "IN:zone:WEST" | "IN:state:07"
  window       String   // "24h" | "3d" | "7d" | "30d"
  trends       Json
  signalCount  Int      @default(0)
  computedAt   DateTime @default(now())
  lastAccessAt DateTime @default(now())

  @@unique([regionKey, window])
  @@index([computedAt])
  @@index([lastAccessAt])
}

model FeedCatalog {
  id                String    @id @default(cuid())
  name              String
  url               String    @unique
  sourceLabel       String
  category          String
  region            String    @default("GLOBAL")
  language          String    @default("en")
  isActive          Boolean   @default(true)
  lastFetchedAt     DateTime?
  lastErrorAt       DateTime?
  consecutiveErrors Int       @default(0)
  createdAt         DateTime  @default(now())
}

model RankedTrend {
  id          String   @id @default(cuid())
  rank        Int
  topic       String
  score       Int
  reason      String   @db.Text
  category    String?
  region      String?  // "DOMESTIC" | "INTERNATIONAL" (relative to user's country)
  originalUrl String?
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, region, createdAt])
}

// ==============================================================================
// ANOMALY DETECTION (Phase 2)
// ==============================================================================

model AnomalyBaseline {
  id            String   @id @default(cuid())
  dimension     String   // KEYWORD | ENTITY | COUNTRY | SENTIMENT
  key           String   // "tariffs", "Donald Trump::PERSON", "IN", "sentiment::tariffs"
  mean          Float    @default(0)
  m2            Float    @default(0)
  sampleCount   Int      @default(0)
  lastValue     Float    @default(0)
  lastUpdatedAt DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([dimension, key])
  @@index([dimension])
}

model AnomalyEvent {
  id             String    @id @default(cuid())
  type           String    // KEYWORD_SPIKE | ENTITY_SURGE | SENTIMENT_SHIFT | GEO_CONCENTRATION
  key            String    // same key format as AnomalyBaseline
  label          String    // human-readable: "tariffs", "Donald Trump", "India"
  zScore         Float
  currentValue   Float
  baselineMean   Float
  baselineStdDev Float
  severity       String    // ELEVATED | HIGH | CRITICAL
  isResolved     Boolean   @default(false)
  resolvedAt     DateTime?
  autoResolvesAt DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([type, isResolved])
  @@index([severity, isResolved])
  @@index([isResolved, createdAt])
  @@index([key, isResolved])
}

model Project {
  id             String   @id @default(cuid())
  title          String
  type           String
  // Status: DRAFT, DISCOVERING, TRACKING, DORMANT, COMPLETED, FAILED
  status         String   @default("DRAFT")
  brief          Json?
  researchData   String?  @db.Text
  finalOutput    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  user           User     @relation(fields: [userId], references: [id])

  narrativeNodes NarrativeNode[]
}

// ==============================================================================
// NARRATIVE TREE (Phase 4)
// ==============================================================================

model NarrativeNode {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentId     String?
  parent       NarrativeNode?  @relation("NarrativeTree", fields: [parentId], references: [id])
  children     NarrativeNode[] @relation("NarrativeTree")

  title        String
  summary      String?   @db.Text
  keywords     String[]
  status       String    @default("ACTIVE")

  signalCount  Int       @default(0)
  lastSignalAt DateTime?
  arcPhase     String?   // EMERGENCE | ESCALATION | PEAK | RESOLUTION

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  events       NarrativeEvent[]
  stakeholders NarrativeStakeholder[]

  @@index([projectId])
  @@index([parentId])
}

model NarrativeEvent {
  id          String   @id @default(cuid())
  nodeId      String
  node        NarrativeNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  title       String
  summary     String?  @db.Text
  sourceUrl   String?
  impactScore Float    @default(0)
  sentiment   String?

  createdAt   DateTime @default(now())

  @@index([nodeId, createdAt])
}

model NarrativeStakeholder {
  id           String   @id @default(cuid())
  nodeId       String
  node         NarrativeNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  name         String
  type         String        // PERSON | ORG | COMPANY | COUNTRY
  role         String?       // PROTAGONIST | ANTAGONIST | REGULATOR | OBSERVER
  sentiment    Float?        // -1.0 to 1.0
  mentionCount Int           @default(0)
  lastSeenAt   DateTime?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([nodeId, name, type])
  @@index([nodeId])
}

// ==============================================================================
// API KEY AUTH & USAGE TRACKING (Phase 6A)
// ==============================================================================

model ApiKey {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  key           String    @unique
  prefix        String
  scopes        String[]
  rateLimit     Int       @default(100)
  requestCount  Int       @default(0)
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  usageLogs     ApiUsageLog[]

  @@index([key])
  @@index([userId])
}

model ApiUsageLog {
  id             String   @id @default(cuid())
  keyId          String
  apiKey         ApiKey   @relation(fields: [keyId], references: [id], onDelete: Cascade)
  endpoint       String
  method         String
  statusCode     Int
  responseTimeMs Int
  createdAt      DateTime @default(now())

  @@index([keyId, createdAt])
  @@index([createdAt])
}

model ApiUsageDailyStat {
  id            String   @id @default(cuid())
  keyId         String
  date          DateTime @db.Date
  totalRequests Int      @default(0)
  errorCount    Int      @default(0)
  avgResponseMs Int      @default(0)
  endpoints     Json?
  createdAt     DateTime @default(now())

  @@unique([keyId, date])
  @@index([keyId])
  @@index([date])
}

// ==============================================================================
// WEBHOOKS & EVENT DELIVERY (Phase 6C)
// ==============================================================================

model Webhook {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url        String
  events     String[]
  secret     String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id            String    @id @default(cuid())
  webhookId     String
  webhook       Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventType     String
  payload       Json
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  nextRetryAt   DateTime?
  statusCode    Int?
  responseBody  String?   @db.Text
  error         String?   @db.Text
  createdAt     DateTime  @default(now())

  @@index([webhookId, status])
  @@index([status, nextRetryAt])
  @@index([createdAt])
}

model WebhookEvent {
  id        String   @id @default(cuid())
  eventType String
  userId    String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([eventType, userId, createdAt])
  @@index([createdAt])
}

// ==============================================================================
// PRICING & SUBSCRIPTIONS
// ==============================================================================

model Plan {
  id            String   @id @default(cuid())
  slug          String   @unique // "free", "pro", "enterprise", "unlimited"
  name          String           // "Free", "Pro", "Enterprise", "Unlimited"
  description   String?

  priceMonthly  Int      @default(0) // paise (49900 = ₹499)
  priceYearly   Int      @default(0) // paise (499900 = ₹4,999)

  // Limits (-1 means unlimited)
  maxSources         Int     @default(5)
  maxProjects        Int     @default(2)
  maxArticles        Int     @default(500)
  maxApiKeys         Int     @default(1)
  maxApiCallsPerDay  Int     @default(100)
  maxWebhooks        Int     @default(0)
  maxNarrativePerDay Int     @default(1)
  hasMarketFull      Boolean @default(false)
  hasExport          Boolean @default(false)

  subscriptions Subscription[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan   @relation(fields: [planId], references: [id])

  status    String @default("ACTIVE")  // ACTIVE, CANCELLED, PAST_DUE, EXPIRED
  source    String @default("FREE")    // FREE, RAZORPAY, REDEEM_CODE

  // Razorpay fields (null for free/redeem)
  razorpayCustomerId     String?
  razorpaySubscriptionId String? @unique
  razorpayPlanId         String?

  // Redeem code reference
  redeemCodeId String?
  redeemCode   RedeemCode? @relation(fields: [redeemCodeId], references: [id])

  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([razorpaySubscriptionId])
}

model RedeemCode {
  id        String    @id @default(cuid())
  code      String    @unique // e.g., "KHABRI-A7KX-M2PF"
  label     String?           // admin note: "For Mom", "For Raj"
  planSlug  String    @default("unlimited")
  maxUses   Int       @default(1)
  useCount  Int       @default(0)
  isActive  Boolean   @default(true)
  expiresAt DateTime?

  subscriptions Subscription[]
  redemptions   Redemption[]

  createdBy String // userId of admin
  createdAt DateTime @default(now())
}

model Redemption {
  id           String     @id @default(cuid())
  redeemCodeId String
  redeemCode   RedeemCode @relation(fields: [redeemCodeId], references: [id])
  userId       String
  redeemedAt   DateTime   @default(now())

  @@unique([redeemCodeId, userId])
  @@index([userId])
}

