datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  sources         Source[]
  userArticles    UserArticleState[]
  // This new line creates the necessary connection to the user's trend data.
  trendDataPoints TrendDataPoint[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  projects      Project[]
  rankedTrends  RankedTrend[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

enum SourceType {
  RSS
}

model Source {
  id          String   @id @default(cuid())
  name        String
  url         String   @unique
  category    String?  @default("General") // ✅ Made optional with default
  type        String   @default("RSS")     // ✅ Added type field to match your API
  isActive    Boolean  @default(true)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  articles    Article[]
  
  createdAt   DateTime @default(now())     // ✅ Added missing field
}


model Article {
  id             String            @id @default(cuid())
  sourceId       String
  source         Source            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title          String
  link           String            @unique
  content        String?           @db.Text
  cleanedContent String?           @db.Text
  publishedDate  DateTime
  guid           String            @unique
  analysis       ArticleAnalysis?
  userStates     UserArticleState[]
  createdAt      DateTime          @default(now())
}

model ArticleAnalysis {
  id        String   @id @default(cuid())
  articleId String   @unique
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  summary   String?  @db.Text
  keywords  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserArticleState {
  userId    String
  articleId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  isRead    Boolean @default(false)
  isSaved   Boolean @default(false)
  readAt    DateTime?
  @@id([userId, articleId])
}

model TrendDataPoint {
  id        String   @id @default(cuid())
  keyword   String
  timestamp DateTime
  count     Int
  createdAt DateTime @default(now())

  // These new lines add the connection to the User model.
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // This updates the unique constraint to be per-user, which is more robust.
  @@unique([keyword, timestamp, userId], name: "keyword_timestamp_userId")
}

model Signal {
  id          String   @id @default(cuid())
  title       String
  url         String   @unique
  source      String
  publishedAt DateTime
  createdAt   DateTime @default(now())
}

model RankedTrend {
  id          String   @id @default(cuid())
  rank        Int
  topic       String
  score       Int
  reason      String   @db.Text
  originalUrl String?
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Project {
  id             String   @id @default(cuid())
  title          String
  // Types: BHUPEN_SCRIPT, BLOG_POST, TWITTER_THREAD
  type           String   
  // Status: DRAFT, RESEARCHING, RESEARCHED, GENERATING, COMPLETED, FAILED
  status         String   @default("DRAFT")
  
  // Stores the specific topic/brief
  brief          Json?    
  
  // The raw Deep Research report or Research Dossier
  researchData   String?  @db.Text 
  
  // The final generated content (Script, Blog HTML, Tweet Text)
  finalOutput    String?  @db.Text
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  user           User     @relation(fields: [userId], references: [id])
}

